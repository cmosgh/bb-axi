{
  "name": "bb-axi",
  "version": "0.1.4",
  "description": "AXI-compliant Bitbucket Cloud CLI for agents - PR review first: diffs, comments, approvals, build status - with token-efficient TOON output",
  "type": "module",
  "keywords": [
    "bitbucket",
    "cli",
    "agent",
    "axi",
    "toon",
    "pull-request",
    "code-review"
  ],
  "bin": {
    "bb-axi": "dist/bin/bb-axi.js"
  },
  "files": [
    "dist",
    "skills/bb-axi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/bin/bb-axi.js', 0o755)\"",
    "build:skill": "tsx scripts/build-skill.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run build:skill -- --check",
    "dev": "tsx bin/bb-axi.ts",
    "prepublishOnly": "pnpm run check"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "@toon-format/toon": "^4.1.1",
    "axi-sdk-js": "^0.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "author": "Cristian Mos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmosgh/bb-axi.git"
  },
  "homepage": "https://github.com/cmosgh/bb-axi#readme",
  "bugs": {
    "url": "https://github.com/cmosgh/bb-axi/issues"
  },
  "packageManager": "pnpm@10.28.2"
}
